# PeerPal landing site — environment configuration
# Copy to .env (or set these in your Vercel project settings) and fill in.
# All VITE_* vars are embedded into the client bundle at build time.

# Waitlist: an endpoint that accepts a JSON POST of { email, source }.
# This is served by the PeerPal backend (peerpal-app) at POST /api/waitlist,
# which writes to the app's Postgres `waitlist_signups` table. Set this to the
# backend's public URL, e.g.:
#   VITE_WAITLIST_ENDPOINT=https://<your-railway-domain>.up.railway.app/api/waitlist
# If left unset, the form will NOT fake a sign-up — it tells the visitor to check
# back and logs a warning to the console.
VITE_WAITLIST_ENDPOINT=

# Official PeerPal social profiles. These default to the live profiles in
# src/main.jsx; set them here only to override (e.g. for a staging brand).
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
