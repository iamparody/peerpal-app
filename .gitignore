# Environment — never commit secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
# Any downloaded/renamed env file, e.g. "peerpal (1).env" (.env.example stays tracked)
*.env
*.env.*
!*.env.example
!.env.example

# Dependencies
node_modules/
src/backend/node_modules/
src/frontend/node_modules/

# Build output
src/frontend/dist/
src/frontend/build/
src/backend/dist/
landing-site/dist/

# Generated outputs / pitch decks (binary, not source)
outputs/

# Landing site has its own git repo — managed independently
landing-site/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Security — private keys and service accounts
*.pem
*.key
*service-account*.json
*firebase-adminsdk*.json
firebase-service-account*.json
src/backend/config/*.json

# Audio files (large binary assets — source from Freesound.org per README)
src/frontend/public/sounds/

# Debug screenshots (Playwright / manual captures)
*.png
*.jpg
pw-screenshot*.mjs
verify*.sh
